<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        pageTitle="Organic Beverages - Greenleaf Organics"
        jcr:primaryType="cq:PageContent"
        jcr:title="Beverages"
        cq:template="/conf/greenleaf-organics/settings/wcm/templates/product-listing"
        sling:resourceType="greenleaf-organics/components/page"
        navTitle="Beverages"
        isShowInNavigation="{Boolean}true">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="greenleaf-organics/components/container"
            layout="responsiveGrid">
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/container"
                layout="responsiveGrid">
            <banner-section
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/container"
                layout="responsiveGrid">
                <herobanner
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/herobanner"
                    backgroundImage="/content/dam/greenleaf-organics/images/hero/coco-tafoya-Lwicl8B_u4E-unsplash.jpg"
                    heading="Beverages"
                    subheading="Refreshing organic drinks for every occasion"
                    overlayOpacity="{Long}35"/>
            </banner-section>
            <product-grid
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/container"
                layout="responsiveGrid">
                <title
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/title"
                    jcr:title="Our Beverage Selection"
                    type="h2"/>
                <productcard-1
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/productcard"
                    productImage="/content/dam/greenleaf-organics/images/products/giorgi-iremadze-3OV0ft7mG_o-unsplash.jpg"
                    productName="Green Power Smoothie"
                    price="$7.49"
                    badge="Vegan"
                    description="Cold-pressed blend of kale, spinach, apple, and ginger."
                    linkURL="/content/greenleaf-organics/us/en/products/beverages/green-power-smoothie"/>
                <productcard-2
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/productcard"
                    productImage="/content/dam/greenleaf-organics/images/products/andrew-valdivia-mMI5sdLFoHM-unsplash.jpg"
                    productName="Cold Brew Coffee"
                    price="$6.99"
                    badge="Organic"
                    description="Slow-steeped for 18 hours using single-origin organic beans for a smooth, bold taste."
                    linkURL="/content/greenleaf-organics/us/en/products/beverages/cold-brew-coffee"/>
                <productcard-3
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/productcard"
                    productImage="/content/dam/greenleaf-organics/images/products/plant-X2VzvQUlLsE-unsplash.jpg"
                    productName="Herbal Kombucha"
                    price="$4.99"
                    badge="Vegan"
                    description="Naturally fermented kombucha with lavender and chamomile for a calming, probiotic-rich drink."
                    linkURL="/content/greenleaf-organics/us/en/products/beverages/herbal-kombucha"/>
            </product-grid>
            </container>
        </root>
    </jcr:content>
</jcr:root>
