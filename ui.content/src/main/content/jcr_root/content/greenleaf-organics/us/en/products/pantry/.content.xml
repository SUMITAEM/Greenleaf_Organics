<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        pageTitle="Pantry Staples - Greenleaf Organics"
        jcr:primaryType="cq:PageContent"
        jcr:title="Pantry Staples"
        cq:template="/conf/greenleaf-organics/settings/wcm/templates/product-listing"
        sling:resourceType="greenleaf-organics/components/page"
        isShowInNavigation="{Boolean}true">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="greenleaf-organics/components/container"
            layout="responsiveGrid">
            <banner-section
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/container"
                layout="responsiveGrid">
                <herobanner
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/herobanner"
                    backgroundImage="/content/dam/greenleaf-organics/images/hero/denise-johnson-CQpN2IdkSdA-unsplash.jpg"
                    heading="Pantry Staples"
                    subheading="Stock your kitchen with organic essentials"
                    overlayOpacity="{Long}35"/>
            </banner-section>
            <product-grid
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/container"
                layout="responsiveGrid">
                <title
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/title"
                    jcr:title="Our Pantry Selection"
                    type="h2"/>
                <productcard-1
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/productcard"
                    productImage="/content/dam/greenleaf-organics/images/products/arwin-neil-baichoo-yQzrDgU-KAI-unsplash.jpg"
                    productName="Raw Wildflower Honey"
                    price="$12.99"
                    badge="Local"
                    description="Unfiltered, unheated honey from local wildflower meadows."
                    linkURL="/content/greenleaf-organics/us/en/products/pantry"/>
                <productcard-2
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/productcard"
                    productImage="/content/dam/greenleaf-organics/images/products/david-magalhaes-HGzn4Puc3Hc-unsplash.jpg"
                    productName="Organic Quinoa"
                    price="$8.99"
                    badge="Organic"
                    description="Premium whole-grain quinoa, a complete protein source rich in fiber and minerals."
                    linkURL="/content/greenleaf-organics/us/en/products/pantry"/>
                <productcard-3
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/productcard"
                    productImage="/content/dam/greenleaf-organics/images/products/roberta-sorge-uOBApnN_K7w-unsplash.jpg"
                    productName="Extra Virgin Olive Oil"
                    price="$14.99"
                    badge="Organic"
                    description="Cold-pressed from organically grown olives for a smooth, peppery finish."
                    linkURL="/content/greenleaf-organics/us/en/products/pantry"/>
            </product-grid>
        </root>
    </jcr:content>
</jcr:root>
