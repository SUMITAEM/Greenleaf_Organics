<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        pageTitle="Contact Us - Greenleaf Organics"
        jcr:primaryType="cq:PageContent"
        jcr:title="Contact"
        cq:template="/conf/greenleaf-organics/settings/wcm/templates/contact-page"
        sling:resourceType="greenleaf-organics/components/page"
        isShowInNavigation="{Boolean}true">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="greenleaf-organics/components/container"
            layout="responsiveGrid">
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/container"
                layout="responsiveGrid">
                <title
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/title"
                    jcr:title="Get in Touch"
                    type="h1"
                    editable="{Boolean}true"/>
                <contact-form-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/container"
                    layout="responsiveGrid">
                    <title
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="greenleaf-organics/components/title"
                        jcr:title="Send Us a Message"
                        type="h2"/>
                    <text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="greenleaf-organics/components/text"
                        textIsRich="true"
                        text="&lt;p&gt;We'd love to hear from you. Fill out the form below and we'll get back to you within 24 hours.&lt;/p&gt;"/>
                    <form
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="greenleaf-organics/components/form/container"
                        actionType="mail"
                        id="contact-form">
                        <name
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="greenleaf-organics/components/form/text"
                            name="name"
                            jcr:title="Full Name"
                            type="text"
                            required="{Boolean}true"
                            constraintMessage="Please enter your name"/>
                        <email
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="greenleaf-organics/components/form/text"
                            name="email"
                            jcr:title="Email Address"
                            type="email"
                            required="{Boolean}true"
                            constraintMessage="Please enter a valid email address"/>
                        <message
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="greenleaf-organics/components/form/text"
                            name="message"
                            jcr:title="Message"
                            type="textarea"
                            rows="{Long}6"
                            required="{Boolean}true"
                            constraintMessage="Please enter your message"/>
                        <submit
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="greenleaf-organics/components/form/button"
                            jcr:title="Send Message"
                            type="submit"/>
                    </form>
                </contact-form-section>
                <map-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/container"
                    layout="responsiveGrid">
                    <title
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="greenleaf-organics/components/title"
                        jcr:title="Find Us"
                        type="h2"/>
                    <text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="greenleaf-organics/components/text"
                        textIsRich="true"
                        text="&lt;p&gt;Visit our flagship store and organic market&lt;/p&gt;"/>
                    <embed
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="greenleaf-organics/components/embed"
                        type="html"
                        html="&lt;div class=&quot;map-placeholder&quot; style=&quot;width:100%;height:400px;background:#e8e8e8;display:flex;align-items:center;justify-content:center;&quot;&gt;&lt;p&gt;Map embed placeholder - Configure with Google Maps API key&lt;/p&gt;&lt;/div&gt;"/>
                </map-section>
                <location-info-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/container"
                    layout="responsiveGrid">
                    <title
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="greenleaf-organics/components/title"
                        jcr:title="Store Locations"
                        type="h2"/>
                    <text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="greenleaf-organics/components/text"
                        textIsRich="true"
                        text="&lt;h3&gt;Greenleaf Organics Headquarters &amp;amp; Flagship Store&lt;/h3&gt;&lt;p&gt;1250 Organic Way, Suite 100&lt;br/&gt;San Jose, CA 95110&lt;br/&gt;Phone: (408) 555-0142&lt;br/&gt;Email: hello@greenleaforganics.com&lt;br/&gt;Hours: Monday – Saturday, 8:00 AM – 8:00 PM | Sunday, 9:00 AM – 6:00 PM&lt;/p&gt;&lt;h3&gt;Greenleaf Organics – Palo Alto Market&lt;/h3&gt;&lt;p&gt;820 University Avenue&lt;br/&gt;Palo Alto, CA 94301&lt;br/&gt;Phone: (650) 555-0198&lt;br/&gt;Email: paloalto@greenleaforganics.com&lt;br/&gt;Hours: Monday – Saturday, 9:00 AM – 7:00 PM | Sunday, 10:00 AM – 5:00 PM&lt;/p&gt;"/>
                </location-info-section>
            </container>
        </root>
    </jcr:content>
</jcr:root>
