<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        pageTitle="Blog - Greenleaf Organics"
        jcr:primaryType="cq:PageContent"
        jcr:title="Blog"
        cq:template="/conf/greenleaf-organics/settings/wcm/templates/page-content"
        sling:resourceType="greenleaf-organics/components/page"
        navTitle="Blog"
        isShowInNavigation="{Boolean}true">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="greenleaf-organics/components/container"
            layout="responsiveGrid">
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/container"
                layout="responsiveGrid">
            <title
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/title"
                jcr:title="Greenleaf Blog"
                type="h1"/>
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/container"
                layout="responsiveGrid">
                <title
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/title"
                    jcr:title="Latest Articles"
                    type="h2"/>
                <teaser-organic-living
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/teaser"
                    jcr:title="10 Tips for Organic Living on a Budget"
                    jcr:description="Discover practical strategies to embrace an organic lifestyle without breaking the bank. From seasonal shopping to growing your own herbs, learn how to make organic living accessible for every family."
                    actionsEnabled="false"
                    linkURL="/content/greenleaf-organics/us/en/blog/organic-living-guide"
                    fileReference="/content/dam/greenleaf-organics/images/blog/organic-living.jpg"/>
                <teaser-seasonal-recipes
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/teaser"
                    jcr:title="Seasonal Recipes: Fall Harvest Edition"
                    jcr:description="Celebrate the bounty of autumn with our collection of wholesome recipes featuring seasonal organic produce. From hearty soups to rustic roasted vegetables, make the most of fall's finest ingredients."
                    actionsEnabled="false"
                    linkURL="/content/greenleaf-organics/us/en/blog/seasonal-recipes"
                    fileReference="/content/dam/greenleaf-organics/images/blog/seasonal-recipes.jpg"/>
            </container>
            </container>
        </root>
    </jcr:content>
</jcr:root>
