<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        pageTitle="Greenleaf Organics - Fresh Organic Products"
        jcr:primaryType="cq:PageContent"
        jcr:title="Greenleaf Organics"
        cq:template="/conf/greenleaf-organics/settings/wcm/templates/home-page"
        sling:resourceType="greenleaf-organics/components/page"
        isShowInNavigation="{Boolean}true">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="greenleaf-organics/components/container"
            layout="responsiveGrid">
            <hero-section
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/container"
                layout="responsiveGrid">
                <herobanner
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/herobanner"
                    backgroundImage="/content/dam/greenleaf-organics/images/hero/home-hero.jpg"
                    heading="Fresh From Farm to Table"
                    subheading="Discover certified organic produce, pantry staples, and wellness products delivered to your door"
                    ctaLabel="Shop Now"
                    ctaLink="/content/greenleaf-organics/us/en/products"
                    overlayOpacity="{Long}40"/>
            </hero-section>
            <featured-categories
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/container"
                layout="responsiveGrid">
                <title
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/title"
                    jcr:title="Shop by Category"
                    type="h2"/>
                <categorycard-produce
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/categorycard"
                    categoryImage="/content/dam/greenleaf-organics/images/categories/fresh-produce.jpg"
                    categoryName="Fresh Produce"
                    linkURL="/content/greenleaf-organics/us/en/products/fresh-produce"/>
                <categorycard-pantry
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/categorycard"
                    categoryImage="/content/dam/greenleaf-organics/images/categories/pantry.jpg"
                    categoryName="Pantry Staples"
                    linkURL="/content/greenleaf-organics/us/en/products/pantry"/>
                <categorycard-beverages
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/categorycard"
                    categoryImage="/content/dam/greenleaf-organics/images/categories/beverages.jpg"
                    categoryName="Beverages"
                    linkURL="/content/greenleaf-organics/us/en/products/beverages"/>
                <categorycard-wellness
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/categorycard"
                    categoryImage="/content/dam/greenleaf-organics/images/categories/wellness.jpg"
                    categoryName="Wellness"
                    linkURL="/content/greenleaf-organics/us/en/products/wellness"/>
            </featured-categories>
            <product-highlights
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/container"
                layout="responsiveGrid">
                <title
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/title"
                    jcr:title="Featured Products"
                    type="h2"/>
                <productcard-1
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/productcard"
                    productImage="/content/dam/greenleaf-organics/images/products/organic-avocados.jpg"
                    productName="Organic Avocados"
                    price="$5.99"
                    badge="Organic"
                    description="Perfectly ripe Hass avocados grown without synthetic pesticides."
                    linkURL="/content/greenleaf-organics/us/en/products/fresh-produce"/>
                <productcard-2
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/productcard"
                    productImage="/content/dam/greenleaf-organics/images/products/raw-honey.jpg"
                    productName="Raw Wildflower Honey"
                    price="$12.99"
                    badge="Local"
                    description="Unfiltered, unheated honey from local wildflower meadows."
                    linkURL="/content/greenleaf-organics/us/en/products/pantry"/>
                <productcard-3
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/productcard"
                    productImage="/content/dam/greenleaf-organics/images/products/green-smoothie.jpg"
                    productName="Green Power Smoothie"
                    price="$7.49"
                    badge="Vegan"
                    description="Cold-pressed blend of kale, spinach, apple, and ginger."
                    linkURL="/content/greenleaf-organics/us/en/products/beverages"/>
            </product-highlights>
            <testimonials-section
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/container"
                layout="responsiveGrid">
                <title
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/title"
                    jcr:title="What Our Customers Say"
                    type="h2"/>
                <testimonial-1
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/testimonial"
                    quote="Greenleaf has completely transformed how my family eats. The produce is always fresh, and knowing it's organic gives me peace of mind."
                    authorImage="/content/dam/greenleaf-organics/images/team/customer-sarah.jpg"
                    authorName="Sarah M."
                    authorRole="Loyal Customer"
                    starRating="{Long}5"/>
                <testimonial-2
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/testimonial"
                    quote="The quality and variety of organic products is unmatched. I love supporting a company that truly cares about sustainability."
                    authorImage="/content/dam/greenleaf-organics/images/team/customer-james.jpg"
                    authorName="James T."
                    authorRole="Health Enthusiast"
                    starRating="{Long}5"/>
            </testimonials-section>
            <newsletter-section
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/container"
                layout="responsiveGrid">
                <newsletter
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/newslettersignup"
                    heading="Stay Fresh with Greenleaf"
                    description="Subscribe to our newsletter for seasonal recipes, wellness tips, and exclusive offers."
                    placeholder="Enter your email address"
                    buttonLabel="Subscribe"/>
            </newsletter-section>
        </root>
    </jcr:content>
</jcr:root>
