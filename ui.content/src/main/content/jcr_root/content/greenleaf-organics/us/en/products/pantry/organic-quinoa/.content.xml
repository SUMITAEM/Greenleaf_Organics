<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        pageTitle="Organic Quinoa - Greenleaf Organics"
        jcr:primaryType="cq:PageContent"
        jcr:title="Organic Quinoa"
        cq:template="/conf/greenleaf-organics/settings/wcm/templates/product-detail"
        sling:resourceType="greenleaf-organics/components/page"
        hideInNav="{Boolean}true">
        <root jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/container" layout="responsiveGrid">
            <container jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/container" layout="responsiveGrid">
                <product-image-section jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/container" layout="responsiveGrid">
                    <image jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/image" fileReference="/content/dam/greenleaf-organics/images/products/organic-quinoa.jpg" alt="Organic Quinoa"/>
                </product-image-section>
                <product-info-section jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/container" layout="responsiveGrid">
                    <title jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/title" jcr:title="Organic Quinoa" type="h1"/>
                    <text jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/text" textIsRich="true"
                        text="&lt;p class=&quot;product-price&quot;&gt;$8.99&lt;/p&gt;&lt;p class=&quot;product-badge&quot;&gt;Certified Organic&lt;/p&gt;&lt;p&gt;Premium whole-grain quinoa, a complete protein source rich in fiber and minerals. Sourced from high-altitude organic farms where the cool climate and mineral-rich soil produce quinoa with exceptional nutritional density.&lt;/p&gt;&lt;p&gt;This versatile superfood cooks in just 15 minutes and has a light, fluffy texture with a subtle nutty flavor. Use it as a base for grain bowls, mix into salads, or serve as a nutritious side dish in place of rice or pasta.&lt;/p&gt;"/>
                </product-info-section>
                <nutrition-section jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/container" layout="responsiveGrid">
                    <title jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/title" jcr:title="Product Details" type="h2"/>
                    <text jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/text" textIsRich="true"
                        text="&lt;h3&gt;Nutrition Facts (per 1/4 cup dry)&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;Calories: 170&lt;/li&gt;&lt;li&gt;Protein: 6g (complete protein)&lt;/li&gt;&lt;li&gt;Fiber: 3g&lt;/li&gt;&lt;li&gt;Iron: 15% DV&lt;/li&gt;&lt;li&gt;Magnesium: 25% DV&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Cooking Instructions&lt;/h3&gt;&lt;p&gt;Rinse quinoa under cold water. Combine 1 cup quinoa with 2 cups water in a saucepan. Bring to a boil, reduce heat, cover, and simmer for 15 minutes. Remove from heat and let stand 5 minutes. Fluff with a fork and serve.&lt;/p&gt;"/>
                </nutrition-section>
            </container>
        </root>
    </jcr:content>
</jcr:root>
