<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        pageTitle="Elderberry Syrup - Greenleaf Organics"
        jcr:primaryType="cq:PageContent"
        jcr:title="Elderberry Syrup"
        cq:template="/conf/greenleaf-organics/settings/wcm/templates/product-detail"
        sling:resourceType="greenleaf-organics/components/page"
        hideInNav="{Boolean}true">
        <root jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/container" layout="responsiveGrid">
            <container jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/container" layout="responsiveGrid">
                <product-image-section jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/container" layout="responsiveGrid">
                    <image jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/text" textIsRich="true" text="&lt;p&gt;&lt;img src=&quot;/content/dam/greenleaf-organics/images/products/tadeusz-zachwieja-ITFBAchRAiI-unsplash.jpg&quot; alt=&quot;Elderberry Syrup&quot; style=&quot;width:100%;height:auto;border-radius:8px&quot;/&gt;&lt;/p&gt;"/>
                </product-image-section>
                <product-info-section jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/container" layout="responsiveGrid">
                    <title jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/title" jcr:title="Elderberry Syrup" type="h1"/>
                    <text jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/text" textIsRich="true"
                        text="&lt;p class=&quot;product-price&quot;&gt;$16.99&lt;/p&gt;&lt;p class=&quot;product-badge&quot;&gt;Certified Organic&lt;/p&gt;&lt;p&gt;Handcrafted elderberry syrup with raw honey and organic spices for immune support. Made in small batches using European black elderberries simmered with organic cinnamon, cloves, and ginger, then sweetened with raw local honey.&lt;/p&gt;&lt;p&gt;Elderberries have been used for centuries as a natural remedy for immune support. Our syrup delivers a concentrated dose of elderberry goodness in a delicious, easy-to-take form that the whole family will love.&lt;p&gt;&lt;button class=&quot;cmp-productcard__add-to-cart&quot; data-product-name=&quot;Elderberry Syrup&quot; data-product-price=&quot;$16.99&quot; data-product-image=&quot;/content/dam/greenleaf-organics/images/products/tadeusz-zachwieja-ITFBAchRAiI-unsplash.jpg&quot; type=&quot;button&quot; style=&quot;padding:0.75rem 2rem;background:#4A7C23;color:#fff;border:none;border-radius:8px;font-weight:600;font-size:1rem;cursor:pointer&quot;&gt;Add to Cart&lt;/button&gt;&lt;/p&gt;&lt;/p&gt;"/>
                </product-info-section>
                <nutrition-section jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/container" layout="responsiveGrid">
                    <title jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/title" jcr:title="Product Details" type="h2"/>
                    <text jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/text" textIsRich="true"
                        text="&lt;h3&gt;Nutrition Facts (per tablespoon)&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;Calories: 35&lt;/li&gt;&lt;li&gt;Total Sugars: 8g (from raw honey)&lt;/li&gt;&lt;li&gt;Anthocyanins: Rich source&lt;/li&gt;&lt;li&gt;Vitamin C: 15% DV&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Suggested Use&lt;/h3&gt;&lt;p&gt;Adults: 1 tablespoon daily for maintenance, 1 tablespoon every 2-3 hours at the onset of illness. Children ages 2-12: 1 teaspoon daily. Take directly or mix into warm water, tea, or juice. Keep refrigerated after opening and use within 90 days. Not suitable for children under 1 year due to honey content.&lt;/p&gt;"/>
                </nutrition-section>
            </container>
        </root>
    </jcr:content>
</jcr:root>
