<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        pageTitle="Fresh Produce - Greenleaf Organics"
        jcr:primaryType="cq:PageContent"
        jcr:title="Fresh Produce"
        cq:template="/conf/greenleaf-organics/settings/wcm/templates/product-listing"
        sling:resourceType="greenleaf-organics/components/page"
        navTitle="Fresh Produce"
        isShowInNavigation="{Boolean}true">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="greenleaf-organics/components/container"
            layout="responsiveGrid">
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/container"
                layout="responsiveGrid">
            <banner-section
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/container"
                layout="responsiveGrid">
                <herobanner
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/herobanner"
                    backgroundImage="/content/dam/greenleaf-organics/images/hero/shelley-pauls-kuR1Kwo4my4-unsplash.jpg"
                    heading="Fresh Produce"
                    subheading="Seasonal fruits and vegetables, harvested at peak ripeness"
                    overlayOpacity="{Long}35"/>
            </banner-section>
            <product-grid
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/container"
                layout="responsiveGrid">
                <title
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/title"
                    jcr:title="Our Fresh Selection"
                    type="h2"/>
                <productcard-1
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/productcard"
                    productImage="/content/dam/greenleaf-organics/images/products/thought-catalog-9aOswReDKPo-unsplash.jpg"
                    productName="Organic Avocados"
                    price="$5.99"
                    badge="Organic"
                    description="Perfectly ripe Hass avocados grown without synthetic pesticides."
                    linkURL="/content/greenleaf-organics/us/en/products/fresh-produce/organic-avocados"/>
                <productcard-2
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/productcard"
                    productImage="/content/dam/greenleaf-organics/images/products/katerina-shkribey-2iU0MzpJIZA-unsplash.jpg"
                    productName="Heirloom Tomatoes"
                    price="$4.49"
                    badge="Local"
                    description="Vine-ripened heirloom varieties bursting with rich, complex flavor."
                    linkURL="/content/greenleaf-organics/us/en/products/fresh-produce/heirloom-tomatoes"/>
                <productcard-3
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/custom/productcard"
                    productImage="/content/dam/greenleaf-organics/images/products/shutter-sphere-collective-6AAptb2kBak-unsplash.jpg"
                    productName="Baby Spinach"
                    price="$3.99"
                    badge="Organic"
                    description="Tender, nutrient-packed baby spinach leaves, triple-washed and ready to enjoy."
                    linkURL="/content/greenleaf-organics/us/en/products/fresh-produce/baby-spinach"/>
            </product-grid>
            </container>
        </root>
    </jcr:content>
</jcr:root>
