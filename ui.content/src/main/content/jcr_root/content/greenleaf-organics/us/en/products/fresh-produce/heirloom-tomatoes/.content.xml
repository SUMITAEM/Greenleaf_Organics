<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        pageTitle="Heirloom Tomatoes - Greenleaf Organics"
        jcr:primaryType="cq:PageContent"
        jcr:title="Heirloom Tomatoes"
        cq:template="/conf/greenleaf-organics/settings/wcm/templates/product-detail"
        sling:resourceType="greenleaf-organics/components/page"
        hideInNav="{Boolean}true">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="greenleaf-organics/components/container"
            layout="responsiveGrid">
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/container"
                layout="responsiveGrid">
                <product-image-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/container"
                    layout="responsiveGrid">
                    <image jcr:primaryType="nt:unstructured" sling:resourceType="greenleaf-organics/components/text" textIsRich="true" text="&lt;p&gt;&lt;img src=&quot;/content/dam/greenleaf-organics/images/products/katerina-shkribey-2iU0MzpJIZA-unsplash.jpg&quot; alt=&quot;Heirloom Tomatoes&quot; style=&quot;width:100%;height:auto;border-radius:8px&quot;/&gt;&lt;/p&gt;"/>
                </product-image-section>
                <product-info-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/container"
                    layout="responsiveGrid">
                    <title
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="greenleaf-organics/components/title"
                        jcr:title="Heirloom Tomatoes"
                        type="h1"/>
                    <text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="greenleaf-organics/components/text"
                        textIsRich="true"
                        text="&lt;p class=&quot;product-price&quot;&gt;$4.49&lt;/p&gt;&lt;p class=&quot;product-badge&quot;&gt;Locally Grown&lt;/p&gt;&lt;p&gt;Vine-ripened heirloom varieties bursting with rich, complex flavor. Our heirloom tomatoes come from local farms that have been cultivating these treasured varieties for generations, preserving the seeds and the traditions behind them.&lt;/p&gt;&lt;p&gt;Available in a stunning mix of colors — deep reds, golden yellows, vibrant greens, and striking purples — each variety offers its own unique taste profile. Perfect for fresh salads, bruschetta, sandwiches, or simply enjoyed with a drizzle of olive oil and fresh basil.&lt;p&gt;&lt;button class=&quot;cmp-productcard__add-to-cart&quot; data-product-name=&quot;Heirloom Tomatoes&quot; data-product-price=&quot;$4.49&quot; data-product-image=&quot;/content/dam/greenleaf-organics/images/products/katerina-shkribey-2iU0MzpJIZA-unsplash.jpg&quot; type=&quot;button&quot; style=&quot;padding:0.75rem 2rem;background:#4A7C23;color:#fff;border:none;border-radius:8px;font-weight:600;font-size:1rem;cursor:pointer&quot;&gt;Add to Cart&lt;/button&gt;&lt;/p&gt;&lt;/p&gt;"/>
                </product-info-section>
                <nutrition-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/container"
                    layout="responsiveGrid">
                    <title
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="greenleaf-organics/components/title"
                        jcr:title="Product Details"
                        type="h2"/>
                    <text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="greenleaf-organics/components/text"
                        textIsRich="true"
                        text="&lt;h3&gt;Nutrition Facts (per medium tomato)&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;Calories: 22&lt;/li&gt;&lt;li&gt;Vitamin C: 28% DV&lt;/li&gt;&lt;li&gt;Vitamin A: 20% DV&lt;/li&gt;&lt;li&gt;Potassium: 292mg&lt;/li&gt;&lt;li&gt;Lycopene: Rich source&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Storage&lt;/h3&gt;&lt;p&gt;Store at room temperature out of direct sunlight for best flavor. Avoid refrigeration as cold temperatures diminish taste and texture. Use within 3-5 days of purchase for optimal freshness.&lt;/p&gt;"/>
                </nutrition-section>
            </container>
        </root>
    </jcr:content>
</jcr:root>
