<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:tags="[]"
        cq:template="/conf/greenleaf-organics/settings/wcm/templates/xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        jcr:primaryType="cq:PageContent"
        jcr:title="Footer"
        sling:resourceType="greenleaf-organics/components/xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="greenleaf-organics/components/container"
            layout="responsiveGrid">
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/container"
                layout="responsiveGrid">
                <about-column
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/text"
                    text="&lt;h3>Greenleaf Organics&lt;/h3>&lt;p>Your trusted source for certified organic produce, pantry staples, beverages, and wellness products. We believe in sustainable farming and delivering nature's best to your table.&lt;/p>"
                    textIsRich="true"/>
                <links-column
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/text"
                    text="&lt;h3>Quick Links&lt;/h3>&lt;ul>&lt;li>&lt;a href='/content/greenleaf-organics/us/en'>Home&lt;/a>&lt;/li>&lt;li>&lt;a href='/content/greenleaf-organics/us/en/products'>Products&lt;/a>&lt;/li>&lt;li>&lt;a href='/content/greenleaf-organics/us/en/about'>About Us&lt;/a>&lt;/li>&lt;li>&lt;a href='/content/greenleaf-organics/us/en/blog'>Blog&lt;/a>&lt;/li>&lt;li>&lt;a href='/content/greenleaf-organics/us/en/contact'>Contact&lt;/a>&lt;/li>&lt;/ul>"
                    textIsRich="true"/>
                <contact-column
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="greenleaf-organics/components/text"
                    text="&lt;h3>Contact Info&lt;/h3>&lt;p>345 Park Avenue&lt;br>San Jose, CA 95110&lt;br>United States&lt;/p>&lt;p>Phone: (408) 555-0142&lt;br>Email: hello@greenleaforganics.com&lt;/p>"
                    textIsRich="true"/>
            </container>
            <separator
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/separator"/>
            <text
                jcr:primaryType="nt:unstructured"
                sling:resourceType="greenleaf-organics/components/text"
                text="&lt;p style='text-align: center;'>&amp;copy; 2026 Greenleaf Organics Inc. All rights reserved.&lt;/p>"
                textIsRich="true"/>
        </root>
    </jcr:content>
</jcr:root>
